<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Picked_Quantity_Cannot_Exceed_Task</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Quantity__c &lt;= 0, Picked_Quantity__c &lt; 0, Picked_Quantity__c > Quantity__c)</errorConditionFormula>
    <errorMessage>Pick quantity must be positive and picked quantity cannot exceed the task quantity.</errorMessage>
</ValidationRule>
