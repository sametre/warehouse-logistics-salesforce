<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Ship_Date_Not_Before_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Order_Date__c)), NOT(ISBLANK(Required_Ship_Date__c)), Required_Ship_Date__c &lt; Order_Date__c)</errorConditionFormula>
    <errorMessage>Required ship date cannot be earlier than the order date.</errorMessage>
</ValidationRule>
