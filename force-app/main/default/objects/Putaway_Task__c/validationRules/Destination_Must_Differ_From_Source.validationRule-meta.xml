<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Destination_Must_Differ_From_Source</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Destination_Bin__c)), Destination_Bin__c = Source_Bin__c)</errorConditionFormula>
    <errorMessage>Destination bin must be different from the source bin.</errorMessage>
</ValidationRule>
